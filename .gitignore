/target
**/target
.DS_Store
/.claude/*
!/.claude/commands/

# Maven build output for the Flink entrant.
entrants/*/target

# Docusaurus site (website/)
website/node_modules
website/build
website/.docusaurus
website/.cache-loader
npm-debug.log*
yarn-error.log

# Result shards under website/static/bench are GENERATED from results/ at build
# time. The JSONL in results/ is the source of truth and is committed; the
# sharded copies are not.
website/static/bench

# Generated into the docs tree at build time from methodology/ by
# website/scripts/sync-docs.mjs. Edit the root files, not the copies.
docs/contract/

# Records from runs whose trigger bars publication — `bench run --trigger
# tuning`, and a PR run. `results::root_for` sends them here rather than into
# results/, so that a configuration search cannot land in the same file as the
# arm's published numbers. They are working data for a search and never an
# archive: the configuration a search settles on is declared in the descriptor
# and re-measured as an ordinary run. Ignored rather than committed because
# `bench validate` refuses these records under results/ and would not see them
# here — so the one way they could quietly accumulate is `git add -A`.
/tuning
