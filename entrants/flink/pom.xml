<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Apache Flink arm of the cross-framework comparison.

  Built inside a `maven:*-eclipse-temurin-17` container by ./Dockerfile; there is
  no Maven on the host and none is needed. See README.md for every version choice
  and its reason.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.kainth.spatebench</groupId>
  <artifactId>comparison-flink</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>Spate comparison :: Flink arm</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>

    <!-- Flink 2.2.1, not 2.3: no flink-connector-kafka release lists 2.3 as
         compatible. The published matrix is connector 5.0.0 -> Flink 2.1.x/2.2.x,
         hence 5.0.0-2.2 below. -->
    <flink.version>2.2.1</flink.version>
    <flink.kafka.connector.version>5.0.0-2.2</flink.kafka.connector.version>

    <!-- ClickHouse's own connector. The Flink minor lives in the *artifactId*
         (…-2.0.0) and the connector's own release is the <version> (0.2.0). The
         published artifact is `pom`-packaged with a single `all` classifier jar
         that shades clickhouse-java, so there is no separate client dependency
         to manage. -->
    <clickhouse.connector.artifact>flink-connector-clickhouse-2.0.0</clickhouse.connector.artifact>
    <clickhouse.connector.version>0.2.0</clickhouse.connector.version>
  </properties>

  <repositories>
    <!-- flink-avro-confluent-registry depends on io.confluent:kafka-schema-registry-client,
         which is NOT on Maven Central. Flink's own pom declares this same repository;
         without it the build fails to resolve that artifact. -->
    <repository>
      <id>confluent</id>
      <url>https://packages.confluent.io/maven/</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
    <!-- ================================================================
         provided: already on the Flink distribution's classpath. Bundling
         these would produce duplicate classes across two classloaders.
         flink-connector-base is inside flink-dist-2.2.1.jar (verified with
         `unzip -l`), which is why the ClickHouse sink's AsyncSinkBase
         superclass resolves without shading it.
         ================================================================ -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-streaming-java</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-clients</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-connector-base</artifactId>
      <version>${flink.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>1.7.36</version>
      <scope>provided</scope>
    </dependency>

    <!-- ================================================================
         bundled: not in flink-dist, so these must be in the job jar.
         ================================================================ -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-connector-kafka</artifactId>
      <version>${flink.kafka.connector.version}</version>
    </dependency>

    <!-- Avro decoding goes through Flink's own shipped schema
         (ConfluentRegistryAvroDeserializationSchema). Per rule 1 of
         methodology/ we do not hand-write a decoder. -->
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-avro-confluent-registry</artifactId>
      <version>${flink.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-avro</artifactId>
      <version>${flink.version}</version>
    </dependency>

    <dependency>
      <groupId>com.clickhouse.flink</groupId>
      <artifactId>${clickhouse.connector.artifact}</artifactId>
      <version>${clickhouse.connector.version}</version>
      <classifier>all</classifier>
    </dependency>
  </dependencies>

  <build>
    <finalName>comparison-flink</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.avro</groupId>
        <artifactId>avro-maven-plugin</artifactId>
        <version>1.11.4</version>
        <executions>
          <execution>
            <phase>generate-sources</phase>
            <goals><goal>schema</goal></goals>
            <configuration>
              <sourceDirectory>${project.basedir}/src/main/resources</sourceDirectory>
              <stringType>String</stringType>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <!-- Signature files from a signed upstream jar do not survive
                       repackaging: the JVM rejects the whole jar with
                       SecurityException if they are kept. -->
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.kainth.spatebench.flink.ComparisonJob</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
