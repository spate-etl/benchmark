# The Vector arm's topology: N kafka sources -> N remap transforms -> 1
# clickhouse sink, in one process on the 32 CPU / 96 GiB envelope.
#
# This file is a TEMPLATE. The image build substitutes `__AVRO_SCHEMA_JSON__`
# with the committed workload/schema/sensor_batch.avsc (methodology/ forbids
# re-declaring the schema inline, and Vector has no Schema Registry client), and
# expands the three marked regions below to N sources, N remaps and N sink
# inputs. Every dollar-brace placeholder is resolved by Vector's own env-var
# interpolation, which 0.58 gates behind
# VECTOR_DANGEROUSLY_ALLOW_ENV_VAR_INTERPOLATION=true — set in the Dockerfile.
# Without it the placeholders stay literal and the numeric fields fail config
# deserialization at the Dockerfile's `vector validate`. The interpolator reads
# the RAW file text, comments included, so no comment here may spell a literal
# placeholder. Defaults after `:-` equal the published knobs.
#
# TOPOLOGY: one kafka source splits a queue per assigned partition and decodes
# each on its own task (src/sources/kafka.rs), so a single source already
# spreads decode across all 32 partitions. N is a knob because each remap's
# OUTPUT path is serial — per row it re-clones event metadata, records a
# latency histogram and walks the row for a size estimate — so N sets how many
# such paths run in parallel. N sources in one group is the in-process analogue
# of the instance-per-partition deployment upstream recommends
# (vectordotdev/vector discussion #15884); the group protocol treats them as it
# would N processes.

# No published figure comes from an arm's self-report, and an idle API server is
# still a listener on the measured process.
api:
  enabled: false

sources:
# >>> per-source
  in-0:
    type: kafka
    bootstrap_servers: "${BOOTSTRAP}"
    topics: ["${TOPIC}"]
    group_id: "${GROUP_ID}"
    # Drain replays a prefilled corpus from the beginning; sustained starts at
    # the tail. The driver supplies the mode's value.
    auto_offset_reset: "${AUTO_OFFSET_RESET:-earliest}"
    # The durability cadence, matched to the 5 s every arm pays. With
    # acknowledgements on, an offset commits only once ClickHouse has acked
    # every row derived from the message.
    commit_interval_ms: 5000
    decoding:
      codec: avro
      avro:
        # Baked at image build from the committed .avsc.
        # `strip_schema_id_prefix` discards the 5-byte Confluent frame without
        # validating the id — declared as a deviation in entrant.toml.
        schema: __AVRO_SCHEMA_JSON__
        strip_schema_id_prefix: true
    librdkafka_options:
      # Incremental rebalance, so a late-joining consumer does not stall the
      # others at start-up.
      "partition.assignment.strategy": "cooperative-sticky"
      # Above the corpus's largest Confluent-framed batch; the 1 MiB default
      # would split fetches into more round-trips than the payload needs.
      "fetch.message.max.bytes": "8388608"
      # Prefetch bound, in KILOBYTES, applied PER PARTITION — so 256 MiB against
      # each of the topic's 32 partitions, whatever N is. In drain the consumer
      # must never be the starved side.
      "queued.max.messages.kbytes": "262144"
# <<< per-source

transforms:
# >>> per-source
  shape-0:
    type: remap
    inputs: ["in-0"]
    file: /etc/vector/transform.vrl
    # Vector's default forwards the ORIGINAL, un-flattened event on a VRL
    # runtime error, which skip_unknown_fields=false would turn into a rejected
    # INSERT carrying a whole batch of good rows. Dropping costs that message's
    # rows, which the loss gate counts. It also skips a per-message clone of the
    # decoded event that the forwarding path would need.
    drop_on_error: true
# <<< per-source

sinks:
  clickhouse:
    type: clickhouse
    inputs:
# >>> per-source
      - shape-0
# <<< per-source
    endpoint: "${CLICKHOUSE_URL}"
    database: default
    table: sensor_events
    # The variant axis. `arrow_stream` is beta in 0.58 and fetches the table
    # schema from system.columns once at start-up; `json_each_row` is the GA
    # default. Resolved at image build, not by interpolation: arrow_stream
    # requires the batch-encoding block below and json_each_row must not carry
    # it, so each variant is generated as its own config and a format the
    # encoder does not match is not expressible.
    format: __FORMAT__
# >>> arrow-only
    # `format` alone only tells ClickHouse which format to expect: without this
    # block Vector announces ArrowStream and then sends JSONEachRow, every
    # insert fails `Code: 117`, and nothing is retried because 400 is not
    # retriable. Vector accepts that pairing; only the server refuses it.
    batch_encoding:
      codec: arrow_stream
# <<< arrow-only
    # DateTime64 columns receive epoch-derived timestamps; best-effort parsing
    # lands them at full precision rather than rejected.
    date_time_best_effort: true
    # An unknown field would mean the transform emitted a column the table does
    # not have — a bug this arm fails on rather than absorbs.
    skip_unknown_fields: false
    auth:
      strategy: basic
      user: default
      password: bench
    query_settings:
      async_insert_settings:
        # ClickHouse 26.3 defaults this on, under which the server acks before
        # the data is written — an ack the acknowledgement chain would trust.
        enabled: false
    batch:
      max_events: ${SINK_BATCH_EVENTS:-262144}
      # max_bytes is measured on in-memory ByteSizeOf, not encoded bytes, and a
      # row of this shape is ~1285 B resident. Set above 262144 of them so
      # max_events is what seals a batch; at the shipped 10 MiB, or at the
      # 256 MiB this arm previously carried, bytes sealed it first.
      max_bytes: 536870912
      # Bounds sustained-mode p99; in drain, batches fill on size first.
      timeout_secs: ${SINK_BATCH_TIMEOUT_SECS:-1}
    request:
      # Fixed width rather than the default adaptive (ARC) controller: a drain
      # window is tens of seconds and ARC spends that long probing its way up.
      # Also the encode width — the sink spawns this many concurrent batch
      # encoders.
      concurrency: ${SINK_REQUEST_CONCURRENCY:-32}
    buffer:
      type: memory
      # The shipped default is 500 events, which cannot feed one batch. 2x the
      # batch so the next fills while the last drains.
      max_events: ${SINK_BUFFER_EVENTS:-524288}
      # Backpressure, not loss: `drop_newest` would break at-least-once while
      # flattering throughput.
      when_full: block
    # Connects a ClickHouse ack back to the source's offset commit; without it
    # the 5 s interval commits offsets for rows the sink may still lose.
    acknowledgements:
      enabled: true
    # The shipped default is gzip, which spends the envelope's scarce CPU to
    # save same-host bandwidth the environment has in abundance.
    compression: "${SINK_COMPRESSION:-none}"
