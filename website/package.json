{
  "name": "spate-benchmark-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "sync": "node scripts/sync-docs.mjs",
    "start": "node scripts/sync-docs.mjs && docusaurus start",
    "build": "node scripts/sync-docs.mjs && docusaurus build",
    "serve": "docusaurus serve",
